# Clerk — the SHARED Atlas instance (copy the values from the Atlas repo's .env).
# Same user pool as Atlas: one login works in both apps. In production both apps
# run on subdomains of relevantaudience.com, so the session cookie is shared and
# Atlas users arrive at AdPulse already signed in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login

# Postgres connection strings for the SHARED Atlas database — Neon `atlas-db`
# (Vercel Marketplace, project sweet-flower-49159593). AdPulse owns only the
# `adpulse` schema there; Atlas owns `public`. Dev uses the `adpulse-dev` Neon
# branch; production uses `main`. Get them with:
#   neonctl connection-string <branch> --project-id sweet-flower-49159593 [--pooled]
# DATABASE_URL is the pooled endpoint (the app); DATABASE_URL_UNPOOLED is the
# direct endpoint, preferred by scripts/migrate.mjs for DDL.
DATABASE_URL=postgresql://<user>:<pass>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<pass>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require

# OpenRouter (get from https://openrouter.ai/keys). Optional — without it the
# chat route degrades to a non-AI "basic mode" summary.
OPENROUTER_API_KEY=

# Windsor.ai — real ad-platform data ingestion (/api/sync).
WINDSOR_API_KEY=

# Optional: canonical public origin (falls back to the request origin).
# NEXT_PUBLIC_SITE_URL=https://adpulse.relevantaudience.com

# Optional: Upstash Redis rate limiting for the public share endpoint, chat, and
# creative generation. BOTH must be set or rate limiting fails open.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob read/write token — required for image uploads (/api/assets).
# Without it, POST/DELETE /api/assets return 503 ("Image uploads are not
# configured") and the uploader shows that error; nothing else is affected and
# the app still boots.
# Store: `adpulse-public` (store_wtuaEJ7d0819ITSG, region sin1), dedicated to
# AdPulse — do NOT reuse Atlas's token. Copy the value from the store's page:
# https://vercel.com/relevant-audiences-projects/~/stores/blob/store_wtuaEJ7d0819ITSG
BLOB_READ_WRITE_TOKEN=
